+
+    fd = open(filename, O_RDONLY);
+    if (fd == -1) {
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+
+    ssize_t bytes_written = read(fd, &usec_slevel, sizeof(usec_slevel));
+    if (bytes_written == -1) {
+        close(fd);
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+    close(fd);
+
+    snprintf(outbuf, 5, "s%d", usec_slevel);
+    return 4;
+}
