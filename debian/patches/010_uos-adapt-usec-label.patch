+static int pr_usecuser(char *restrict const outbuf, const proc_t *restrict const pp){
+    size_t len;
+    unsigned int usec_user = 0xffffffff;
+    char filename[52];
+    ssize_t num_read;
+    int fd;
+    setREL1(ID_PID)
+
+    snprintf(filename, sizeof filename, "/proc/%d/attr/usec/ubits", rSv(ID_PID, s_int, pp));
+
+    fd = open(filename, O_RDONLY);
+    if (fd == -1) {
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+
+    ssize_t bytes_written = read(fd, &usec_user, sizeof(usec_user));
+    if (bytes_written == -1) {
+        close(fd);
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+    close(fd);
+
+    unsigned int first_8_bits = (usec_user >> 24);
+    snprintf(outbuf, 5, "0x%02X", first_8_bits);
+    outbuf[5] = '\0';
+    return 4;
+}
+
+static int trim_usec_attr(const char *full_context, char *output_buffer, size_t buffer_size)
+{
+    if (full_context == NULL || output_buffer == NULL || buffer_size == 0) {
+        return -1;
+    }
+
+    const char *first_colon = strchr(full_context, ':');
+    if (first_colon == NULL) {
+        return -1;
+    }
+
+    const char *second_colon = strchr(first_colon + 1, ':');
+    if (second_colon == NULL) {
+        return -1;
+    }
+
+    const char *third_colon = strchr(second_colon + 1, ':');
+    size_t type_start_index = (second_colon - full_context) + 1;
+    size_t type_end_index;
+
+    if (third_colon != NULL) {
+        type_end_index = (third_colon - full_context);
+    } else {
+        type_end_index = strlen(full_context);
+    }
+
+    size_t type_length = type_end_index - type_start_index;
+
+    if (type_length >= buffer_size) {
+        return -1;
+    }
+    strncpy(output_buffer, full_context + type_start_index, type_length);
+    output_buffer[type_length] = '\0';
+
+    return 0;
+}
+
+static int pr_usecproc(char *restrict const outbuf, const proc_t *restrict const pp){
+    size_t len;
+    char filename[52];
+    ssize_t num_read;
+    int fd;
+    setREL1(ID_PID)
+
+    snprintf(filename, sizeof filename, "/proc/%d/attr/usid", rSv(ID_PID, s_int, pp));
+
+    fd = open(filename, O_RDONLY);
+    if (fd == -1) {
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+
+    ssize_t bytes_read = read(fd, outbuf, OUTBUF_SIZE-1);
+    if (bytes_read == -1) {
+        close(fd);
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+    close(fd);
+    outbuf[bytes_read] = '\0';
+
+    char context[256];
+    if (trim_usec_attr(outbuf, context, sizeof(context)) == 0) {
+        len = strlen(context);
+        memcpy(outbuf, context, len+1);
+        return len;
+    }
+
+    return bytes_read;
+}
+
+static int pr_usecilevel(char *restrict const outbuf, const proc_t *restrict const pp){
+    size_t len;
+    unsigned short int usec_ilevel = 0;
+    char filename[52];
+    ssize_t num_read;
+    int fd;
+    setREL1(ID_PID)
+
+    snprintf(filename, sizeof filename, "/proc/%d/attr/usec/ilevel", rSv(ID_PID, s_int, pp));
+
+    fd = open(filename, O_RDONLY);
+    if (fd == -1) {
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+
+    ssize_t bytes_written = read(fd, &usec_ilevel, sizeof(usec_ilevel));
+    if (bytes_written == -1) {
+        close(fd);
+        outbuf[0] = '-';
+        outbuf[1] = '\0';
+        len = 1;
+        return len;
+    }
+    close(fd);
+
+    snprintf(outbuf, 5, "i%d", usec_ilevel);
+    return 4;
+}
+
+static int pr_usecslevel(char *restrict const outbuf, const proc_t *restrict const pp){
+    size_t len;
+    unsigned short int usec_slevel = 0;
